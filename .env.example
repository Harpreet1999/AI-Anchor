# Copy this file to .env and fill in your own key — .env is gitignored,
# never committed. Get a free key (no card required) at:
# https://console.groq.com/keys

GROQ_API_KEY=

# The Python retrieval service (service-py/), once deployed — see
# service-py/README.md. Leave unset for local dev: Vite's /py-api proxy
# forwards to a local `uvicorn app:app --port 8000` instead (see
# vite.config.js). This must be a VITE_-prefixed var to reach the browser
# bundle, and it's fine to be public — the service is a public,
# unauthenticated, read-only demo endpoint.
VITE_PY_API_URL=
